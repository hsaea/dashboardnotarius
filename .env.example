# Скопіюйте у .env і заповніть реальними значеннями (.env у git не потрапляє)

# Kommo
KOMMO_SUBDOMAIN=frankohold
KOMMO_TOKEN=your-long-lived-kommo-token-here

# Server
PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# Період: з якого місяця тягнути дані (включно). Формат YYYY-MM
SINCE_MONTH=2026-10
TZ_REGION=Europe/Kyiv

# Початкові ставки (далі редагуються в адмінці CEO), грн
SIGN_RATE=220
ACT_RATE=330

# Інтервал синхронізації з Kommo у секундах
SYNC_INTERVAL=600

# MySQL (створіть базу й користувача в панелі хостингу)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Для продакшн-деплою за HTTPS/reverse-proxy (VPS):
# COOKIE_SECURE=1
# TRUST_PROXY=1
